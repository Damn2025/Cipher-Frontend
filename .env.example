# Supabase Configuration
# Get these values from your Supabase project settings
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Backend API URL
# In development, this can be empty (uses relative paths) or set to your local backend URL
# In production, set this to your deployed backend URL (e.g., https://your-backend.workers.dev)
VITE_API_URL=

# Example for local development with Cloudflare Workers:
# VITE_API_URL=http://localhost:8787

# Example for production (use full URL with https://):
# VITE_API_URL=https://www.cybersec-back.evokeai.info
